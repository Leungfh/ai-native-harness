name: Publish static site to GitHub Pages

on:
  workflow_dispatch:
    inputs:
      candidate_sha:
        description: "Reviewed full commit SHA on the default branch"
        type: string
        required: true

      approved_content_sha256:
        description: "SHA-256 from the successful candidate preview"
        type: string
        required: true
      base_path:
        description: "Public base path, e.g. /repo-name/ or /"
        type: string
        required: true
      smoke_route:
        description: "Reviewed page path relative to the base, e.g. guide/"
        type: string
        required: true
      expected_text:
        description: "Expected static HTML body text on that page"
        type: string
        required: true

permissions: {}

concurrency:
  group: pages-production
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-24.04
    timeout-minutes: 25
    outputs:
      artifact_name: ${{ steps.candidate.outputs.artifact_name }}
    permissions:
      contents: read
    steps:
      - name: Check dispatch branch and candidate
        id: candidate
        env:
          EXPECTED_REF: refs/heads/${{ github.event.repository.default_branch }}
          EXPECTED_SHA: ${{ inputs.candidate_sha }}
        run: |
          set -eu
          if [ "$GITHUB_REF" != "$EXPECTED_REF" ] || [ "$GITHUB_SHA" != "$EXPECTED_SHA" ]; then
            echo "::error::Select the default branch and enter its reviewed full SHA."
            exit 1
          fi
          echo "artifact_name=pages-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT" >> "$GITHUB_OUTPUT"
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
        with:
          python-version: "3.12"
      # Add the target site's pinned toolchain steps here if it uses Node or another runtime.
      - name: Run the project checks and build
        run: python3 scripts/harness.py check
      - name: Verify the reviewed content and smoke-test its route
        shell: bash
        env:
          APPROVED: ${{ inputs.approved_content_sha256 }}
          BASE: ${{ inputs.base_path }}
          ROUTE: ${{ inputs.smoke_route }}
          MARKER: ${{ inputs.expected_text }}
        run: |
          set -euo pipefail
          cp -a -- dist "$RUNNER_TEMP/pages-public"
          python3 scripts/pages_candidate.py "$RUNNER_TEMP/pages-public" \
            --base "$BASE" --route "$ROUTE" --contains "$MARKER" --expect "$APPROVED"
      - name: Upload this run's site artifact
        uses: actions/upload-pages-artifact@7b1f4a764d45c48632c6b24a0339c27f5614fb0b # v4.0.0
        with:
          name: ${{ steps.candidate.outputs.artifact_name }}
          path: ${{ runner.temp }}/pages-public
  publish:
    needs: build
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.publish.outputs.page_url }}
    steps:
      - name: Publish the checked artifact
        id: publish
        uses: actions/deploy-pages@d6db90164ac5ed86f2b6aed7e0febac5b3c0c03e # v4.0.5
        with:
          artifact_name: ${{ needs.build.outputs.artifact_name }}
